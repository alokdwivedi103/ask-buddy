# Copy to .env and choose private app/admin credentials.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=180
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=5m
DB_SQLITE_PATH=data/sync_data.db
API_KEY=replace-with-your-private-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-your-private-password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_TIMEOUT=5
REDIS_KEY_PREFIX=reflect
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_TIMEOUT=5
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
